--- !u!114 &791991664
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 791991662}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a2b2a6074ae1165469988c101f29d50f, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  _dialogData:
  - _speakerName: 
    _dialogueText: "\uD559\uC0DD\uD68C\uB85C \uB3CC\uC544\uC628 \uB098\uB294,\n\uAD50\uC7A5\uC2E4\uC5D0\uC11C
      \uB4E4\uC740 \uC774\uC57C\uAE30\uB97C \uADF8\uB300\uB85C \uC804\uD588\uB2E4."
    _illustHide: 1
    _illustChange: 0
    _illustIndex: 0
    _bgmSwitch: 1
    _backgroundSound: 6
    _seChange: 0
    _effectSound: 0
  - _speakerName: "\uBD80\uD68C\uC7A5"
    _dialogueText: "\u2026\u2026\uADF8\uB7EC\uB2C8\uAE4C \uC62C\uD574 \uCD95\uC81C\uB294
      \uC6B0\uB9AC\uAC00 \uC9C1\uC811 \uB9CC\uB4E0\uB2E4\uB294 \uAC70\uC9C0?"
    _illustHide: 0
    _illustChange: 1
    _illustIndex: 1
    _bgmSwitch: 2
    _backgroundSound: 4
    _seChange: 0
    _effectSound: 4
  - _speakerName: "\uD559\uC0DD\uD68C\uC7A5"
    _dialogueText: "\uC751. \uAE30\uD68D\uBD80\uD130 \uC900\uBE44\uAE4C\uC9C0 \uC804\uBD80."
    _illustHide: 0
    _illustChange: 0
    _illustIndex: 0
    _bgmSwitch: 0
    _backgroundSound: 6
    _seChange: 0
    _effectSound: 4
  - _speakerName: "\uCD1D\uBB34\uBD80\uC7A5"
    _dialogueText: "\uC7A0\uAE50, \uADF8\uB7EC\uBA74 \uC608\uC0B0 \uAD00\uB9AC\uB3C4\n\uC804\uBD80
      \uC6B0\uB9AC\uAC00 \uD574\uC57C \uD558\uB294 \uAC70\uC57C?"
    _illustHide: 0
    _illustChange: 0
    _illustIndex: 0
    _bgmSwitch: 0
    _backgroundSound: 6
    _seChange: 0
    _effectSound: 4
  - _speakerName: "\uD559\uC0DD\uD68C\uC7A5"
    _dialogueText: "\uD559\uAD50\uC5D0\uC11C \uC9C0\uC6D0\uC740 \uD574\uC900\uB2E4\uB358\uB370."
    _illustHide: 0
    _illustChange: 0
    _illustIndex: 0
    _bgmSwitch: 0
    _backgroundSound: 6
    _seChange: 0
    _effectSound: 4
  - _speakerName: "\uD559\uC608\uBD80\uC7A5"
    _dialogueText: "\uADFC\uB370 \uADF8\uAC70 \uC7AC\uBC0C\uC9C0 \uC54A\uC544?"
    _illustHide: 0
    _illustChange: 0
    _illustIndex: 0
    _bgmSwitch: 0
    _backgroundSound: 6
    _seChange: 0
    _effectSound: 4
  - _speakerName: "\uCD1D\uBB34\uBD80\uC7A5"
    _dialogueText: "\uB108\uB294 \uC65C \uC2E0\uB09C \uAC74\uB370."
    _illustHide: 0
    _illustChange: 0
    _illustIndex: 0
    _bgmSwitch: 0
    _backgroundSound: 6
    _seChange: 0
    _effectSound: 4
  - _speakerName: "\uD559\uC608\uBD80\uC7A5"
    _dialogueText: "\uC6B0\uB9AC\uAC00 \uD558\uACE0 \uC2F6\uC740 \uCD95\uC81C\uB85C
      \uB9CC\uB4E4 \uC218 \uC788\uB2E4\uB294 \uAC70\uC796\uC544!"
    _illustHide: 0
    _illustChange: 0
    _illustIndex: 0
    _bgmSwitch: 0
    _backgroundSound: 6
    _seChange: 0
    _effectSound: 6
  - _speakerName: "\uD64D\uBCF4\uBD80\uC7A5"
    _dialogueText: "\uBB38\uC81C\uB294 \uC0AC\uB78C\uB4E4\uC774 \uC640\uC918\uC57C
      \uCD95\uC81C\uB77C\uB294 \uAC70\uC9C0."
    _illustHide: 0
    _illustChange: 0
    _illustIndex: 0
    _bgmSwitch: 0
    _backgroundSound: 6
    _seChange: 0
    _effectSound: 6
  - _speakerName: "\uBC14\uB978\uC0DD\uD65C\uBD80\uC7A5"
    _dialogueText: "\uADF8 \uC804\uC5D0 \uC548\uC804\uD558\uAC8C \uC5F4 \uC218 \uC788\uC5B4\uC57C
      \uD558\uACE0."
    _illustHide: 0
    _illustChange: 0
    _illustIndex: 0
    _bgmSwitch: 0
    _backgroundSound: 6
    _seChange: 0
    _effectSound: 6
  - _speakerName: 
    _dialogueText: "......\uBC8C\uC368 \uAC71\uC815\uAC70\uB9AC\uAC00 \uD558\uB098
      \uB458 \uB298\uC5B4\uB098\uAE30 \uC2DC\uC791\uD588\uB2E4."
    _illustHide: 0
    _illustChange: 0
    _illustIndex: 0
    _bgmSwitch: 0
    _backgroundSound: 6
    _seChange: 0
    _effectSound: 6
  - _speakerName: "\uBD80\uD68C\uC7A5"
    _dialogueText: "\uC77C\uB2E8 \uD604\uC7A5\uBD80\uD130 \uD55C\uBC88 \uD655\uC778\uD574\uBCF4\uC790."
    _illustHide: 0
    _illustChange: 0
    _illustIndex: 0
    _bgmSwitch: 0
    _backgroundSound: 6
    _seChange: 0
    _effectSound: 6
  - _speakerName: "\uD559\uC0DD\uD68C\uC7A5"
    _dialogueText: "\uADF8\uB7EC\uC790."
    _illustHide: 0
    _illustChange: 0
    _illustIndex: 0
    _bgmSwitch: 0
    _backgroundSound: 6
    _seChange: 0
    _effectSound: 6
  - _speakerName: 
    _dialogueText: "\uADF8\uB798\uC11C \uC6B0\uB9AC\uB294 \uCD95\uC81C\uB97C \uC5F4
      \uC608\uC815\uC778\n\uBD80\uC9C0\uBD80\uD130 \uD655\uC778\uD558\uAE30\uB85C
      \uD588\uB2E4."
    _illustHide: 1
    _illustChange: 0
    _illustIndex: 0
    _bgmSwitch: 0
    _backgroundSound: 6
    _seChange: 0
    _effectSound: 6
