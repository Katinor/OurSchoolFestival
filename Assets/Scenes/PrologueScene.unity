--- !u!114 &1526708292
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1526708290}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a2b2a6074ae1165469988c101f29d50f, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  _dialogData:
  - _speakerName: 
    _dialogueText: "\uACE0\uBBFC \uB05D\uC5D0, \uB098\uB294 \uACFC\uD559\uBD80\uC2E4\uB85C
      \uD5A5\uD588\uB2E4.\n\uBB38\uC744 \uC5F4\uC790 \uC775\uC219\uD55C \uB4B7\uBAA8\uC2B5\uC774
      \uBCF4\uC600\uB2E4."
    _illustHide: 0
    _illustChange: 1
    _illustIndex: 5
    _bgmSwitch: 2
    _backgroundSound: 8
    _seChange: 0
    _effectSound: 0
  - _speakerName: "\uD559\uC0DD\uD68C\uC7A5"
    _dialogueText: "\uCE74\uD2F0\uB178\uB974."
    _illustHide: 0
    _illustChange: 0
    _illustIndex: 0
    _bgmSwitch: 0
    _backgroundSound: 8
    _seChange: 0
    _effectSound: 0
  - _speakerName: "\uCE74\uD2F0\uB178\uB974"
    _dialogueText: "......\uBB50\uC57C?"
    _illustHide: 0
    _illustChange: 0
    _illustIndex: 5
    _bgmSwitch: 0
    _backgroundSound: 8
    _seChange: 0
    _effectSound: 0
  - _speakerName: "\uD559\uC0DD\uD68C\uC7A5"
    _dialogueText: "\uC62C\uD574 \uD559\uAD50\uCD95\uC81C\uB97C \uD559\uC0DD\uD68C\uAC00
      \uC9C1\uC811 \uC900\uBE44\uD558\uAC8C \uB410\uC5B4."
    _illustHide: 0
    _illustChange: 0
    _illustIndex: 5
    _bgmSwitch: 0
    _backgroundSound: 8
    _seChange: 0
    _effectSound: 0
  - _speakerName: "\uCE74\uD2F0\uB178\uB974"
    _dialogueText: "......\uADF8\uB798\uC11C?"
    _illustHide: 0
    _illustChange: 0
    _illustIndex: 5
    _bgmSwitch: 0
    _backgroundSound: 8
    _seChange: 0
    _effectSound: 0
  - _speakerName: "\uD559\uC0DD\uD68C\uC7A5"
    _dialogueText: "\uD63C\uC790\uC11C\uB294 \uBB34\uB9AC\uC57C.\n\uB124 \uB3C4\uC6C0\uC774
      \uD544\uC694\uD574."
    _illustHide: 0
    _illustChange: 0
    _illustIndex: 5
    _bgmSwitch: 0
    _backgroundSound: 8
    _seChange: 0
    _effectSound: 0
  - _speakerName: "\uCE74\uD2F0\uB178\uB974"
    _dialogueText: "\uC2EB\uC740\uB370."
    _illustHide: 0
    _illustChange: 0
    _illustIndex: 5
    _bgmSwitch: 0
    _backgroundSound: 8
    _seChange: 0
    _effectSound: 0
  - _speakerName: "\uD559\uC0DD\uD68C\uC7A5"
    _dialogueText: "\uADF8\uB798\uB3C4 \uC81C\uC77C \uBA3C\uC800 \uB124\uAC00 \uB5A0\uC62C\uB790\uC5B4."
    _illustHide: 0
    _illustChange: 0
    _illustIndex: 5
    _bgmSwitch: 0
    _backgroundSound: 8
    _seChange: 0
    _effectSound: 0
  - _speakerName: 
    _dialogueText: "\uCE74\uD2F0\uB178\uB974\uB294 \uC7A0\uC2DC \uB9D0\uC774 \uC5C6\uC5C8\uB2E4."
    _illustHide: 0
    _illustChange: 0
    _illustIndex: 5
    _bgmSwitch: 1
    _backgroundSound: 8
    _seChange: 0
    _effectSound: 0
  - _speakerName: "\uCE74\uD2F0\uB178\uB974"
    _dialogueText: "......\uD558\uC544."
    _illustHide: 0
    _illustChange: 0
    _illustIndex: 5
    _bgmSwitch: 0
    _backgroundSound: 8
    _seChange: 0
    _effectSound: 0
  - _speakerName: 
    _dialogueText: "\uC644\uC804\uD788 \uC2B9\uB099\uD55C \uAC74 \uC544\uB2C8\uC5C8\uC9C0\uB9CC,\n\uC801\uC5B4\uB3C4
      \uBB38\uC804\uBC15\uB300\uB294 \uC544\uB2C8\uC5C8\uB2E4."
    _illustHide: 0
    _illustChange: 0
    _illustIndex: 5
    _bgmSwitch: 1
    _backgroundSound: 8
    _seChange: 0
    _effectSound: 0
  - _speakerName: 
    _dialogueText: "\uADF8\uB807\uAC8C \uB098\uB294 \uCCAB \uBC88\uC9F8 \uB3C4\uC6C0\uC744
      \uAD6C\uD588\uACE0,\n<b>\uD559\uAD50\uCD95\uC81C \uC900\uBE44\uB294 \uC774\uC81C
      \uC815\uB9D0 \uC2DC\uC791\uB418\uC5C8\uB2E4.</b>"
    _illustHide: 0
    _illustChange: 0
    _illustIndex: 5
    _bgmSwitch: 1
    _backgroundSound: 8
    _seChange: 0
    _effectSound: 0
