    _dialogueText: "\uD559\uC0DD\uD68C \uD68C\uC758\uAC00 \uB05D\uB09C \uB4A4,\n\uC6B0\uB9AC\uB294
      \uCD95\uC81C\uAC00 \uC5F4\uB9B4 \uC608\uC815\uC778 \uBD80\uC9C0\uB97C \uC9C1\uC811
      \uD655\uC778\uD558\uB7EC \uAC14\uB2E4."
    _illustHide: 1
    _illustChange: 0
    _illustIndex: 0
    _bgmSwitch: 1
    _backgroundSound: 6
    _seChange: 0
    _effectSound: 0
  - _speakerName: "\uD559\uC0DD\uD68C\uC7A5"
    _dialogueText: ......
    _illustHide: 0
    _illustChange: 1
    _illustIndex: 2
    _bgmSwitch: 2
    _backgroundSound: 0
    _seChange: 0
    _effectSound: 0
  - _speakerName: "\uD559\uC0DD\uD68C\uC7A5"
    _dialogueText: "\uC9C4\uC9DC \uC544\uBB34\uAC83\uB3C4 \uC5C6\uC796\uC544."
    _illustHide: 0
    _illustChange: 0
    _illustIndex: 0
    _bgmSwitch: 0
    _backgroundSound: 0
    _seChange: 0
    _effectSound: 0
  - _speakerName: 
    _dialogueText: "\uAD50\uC7A5 \uC120\uC0DD\uB2D8\uC774 \uB9D0\uD55C \u2018\uC790\uC720\uB86D\uAC8C
      \uB9CC\uB4E4\uC5B4\uAC00\uB294 \uCD95\uC81C\u2019\uAC00\n\uBB34\uC2A8 \uB73B\uC778\uC9C0\uB294
      \uC774\uC81C \uD655\uC2E4\uD788 \uC54C \uAC83 \uAC19\uC558\uB2E4."
    _illustHide: 0
    _illustChange: 0
    _illustIndex: 0
    _bgmSwitch: 0
    _backgroundSound: 0
    _seChange: 0
    _effectSound: 0
  - _speakerName: "\uD559\uC0DD\uD68C\uC7A5"
    _dialogueText: "\uC790\uC720\uB85C\uC6B4\uAC8C \uC544\uB2C8\uB77C,\n\uADF8\uB0E5
      \uCC98\uC74C\uBD80\uD130 \uB9CC\uB4E4\uB77C\uB294 \uAC70\uAD6C\uB098."
    _illustHide: 0
    _illustChange: 0
    _illustIndex: 0
    _bgmSwitch: 0
    _backgroundSound: 0
    _seChange: 0
    _effectSound: 0
  - _speakerName: 
    _dialogueText: "\uB113\uC740 \uACF5\uD130\uB97C \uBCF4\uACE0 \uC788\uC73C\uB2C8\n\uD574\uC57C
      \uD560 \uC77C\uC774 \uAC11\uC790\uAE30 \uD6E8\uC52C \uD604\uC2E4\uC801\uC73C\uB85C
      \uB290\uAEF4\uC84C\uB2E4."
    _illustHide: 0
    _illustChange: 0
    _illustIndex: 0
    _bgmSwitch: 0
    _backgroundSound: 0
    _seChange: 0
    _effectSound: 0
  - _speakerName: 
    _dialogueText: "\u2026\u2026\uC77C\uB2E8, \uD63C\uC790 \uACE0\uBBFC\uD574\uBD24\uC790
      \uB2F5\uC740 \uC548 \uB098\uC62C \uAC83 \uAC19\uC558\uB2E4."
    _illustHide: 1
    _illustChange: 0
    _illustIndex: 0
    _bgmSwitch: 0
    _backgroundSound: 0
    _seChange: 0
    _effectSound: 0
