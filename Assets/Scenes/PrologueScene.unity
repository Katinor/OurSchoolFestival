  m_IsActive: 1
--- !u!114 &648939770
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 648939769}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a2b2a6074ae1165469988c101f29d50f, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  _dialogData:
  - _speakerName: 
    _dialogueText: "\uC2AC\uC2AC \uAC00\uC744\uC774 \uB418\uACE0, \uD559\uAD50\uCD95\uC81C\uB97C
      \uC900\uBE44\uD560 \uC2DC\uAE30\uAC00 \uB418\uC5C8\uB2E4.\n\uD559\uC0DD\uD68C\uC7A5\uC778
      \uB098\uB294 \uC5B4\uB290 \uB0A0 \uAD50\uC7A5\uC2E4\uC5D0 \uBD88\uB824\uAC14\uB2E4."
    _illustHide: 1
    _illustChange: 0
    _illustIndex: 0
    _bgmSwitch: 1
    _backgroundSound: 6
    _seChange: 0
    _effectSound: 0
  - _speakerName: "\uAD50\uC7A5 \uC120\uC0DD\uB2D8"
    _dialogueText: "\uC62C\uD574\uB294 \uD559\uC0DD\uB4E4\uC774 \uC9C1\uC811 \uCD95\uC81C\uB97C
      \uB9CC\uB4E4\uC5B4\uBCF4\uB294 \uAC8C \uC5B4\uB5A8\uAE4C\uC694?"
    _illustHide: 0
    _illustChange: 1
    _illustIndex: 0
    _bgmSwitch: 2
    _backgroundSound: 6
    _seChange: 0
    _effectSound: 4
  - _speakerName: "\uD559\uC0DD\uD68C\uC7A5"
    _dialogueText: "\uB124???"
    _illustHide: 0
    _illustChange: 0
    _illustIndex: 0
    _bgmSwitch: 0
    _backgroundSound: 6
    _seChange: 0
    _effectSound: 4
  - _speakerName: "\uAD50\uC7A5 \uC120\uC0DD\uB2D8"
    _dialogueText: "\uD559\uC0DD\uB4E4\uC774 \uC9C1\uC811 \uAE30\uD68D\uD558\uACE0,\n\uC9C1\uC811
      \uC900\uBE44\uD574\uC11C \uB9CC\uB4DC\uB294 \uCD95\uC81C \uB9D0\uC785\uB2C8\uB2E4."
    _illustHide: 0
    _illustChange: 0
    _illustIndex: 0
    _bgmSwitch: 0
    _backgroundSound: 6
    _seChange: 0
    _effectSound: 4
  - _speakerName: "\uD559\uC0DD\uD68C\uC7A5"
    _dialogueText: "\uADF8\u2026\u2026 \uC88B\uAE34 \uD55C\uB370\uC694."
    _illustHide: 0
    _illustChange: 0
    _illustIndex: 0
    _bgmSwitch: 0
    _backgroundSound: 6
    _seChange: 0
    _effectSound: 4
  - _speakerName: "\uAD50\uC7A5 \uC120\uC0DD\uB2D8"
    _dialogueText: "\uAC71\uC815\uD558\uC9C0 \uB9C8\uC138\uC694.\n\uD544\uC694\uD55C
      \uC790\uAE08\uC740 \uD559\uAD50\uC5D0\uC11C \uC9C0\uC6D0\uD560 \uD14C\uB2C8\uAE4C\uC694."
    _illustHide: 0
    _illustChange: 0
    _illustIndex: 0
    _bgmSwitch: 0
    _backgroundSound: 6
    _seChange: 0
    _effectSound: 4
  - _speakerName: 
    _dialogueText: "\uACB0\uAD6D \uADF8\uB0A0, \uB098\uB294 \uAD50\uC7A5 \uC120\uC0DD\uB2D8\uC758
      \uC544\uC8FC \uBC1D\uC740 \uBBF8\uC18C\uC640 \uD568\uAED8\u2014"
    _illustHide: 0
    _illustChange: 0
    _illustIndex: 0
    _bgmSwitch: 0
    _backgroundSound: 6
    _seChange: 0
    _effectSound: 4
  - _speakerName: 
    _dialogueText: "<b>\uC62C\uD574 \uD559\uAD50\uCD95\uC81C\uC758 \uAE30\uD68D\uACFC
      \uC900\uBE44\uB97C\n\uD559\uC0DD\uD68C\uAC00 \uB9E1\uB294\uB2E4\uB294 \uC774\uC57C\uAE30\uB97C
      \uB4E3\uAC8C \uB418\uC5C8\uB2E4.</b>"
    _illustHide: 1
    _illustChange: 0
    _illustIndex: 0
    _bgmSwitch: 1
    _backgroundSound: 6
    _seChange: 1
    _effectSound: 6
