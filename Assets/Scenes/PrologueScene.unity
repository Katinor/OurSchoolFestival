--- !u!114 &1080117757
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1080117755}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a2b2a6074ae1165469988c101f29d50f, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  _dialogData:
  - _speakerName: 
    _dialogueText: "\uACF5\uD130\uB97C \uB458\uB7EC\uBCF8 \uB4A4,\n\uC6B0\uB9AC\uB294
      \uC900\uBE44\uD574 \uC628 \uC9C0\uB3C4\uB97C \uD3BC\uCCD0 \uB193\uACE0 \uC758\uACAC\uC744
      \uBAA8\uC73C\uAE30 \uC2DC\uC791\uD588\uB2E4."
    _illustHide: 0
    _illustChange: 1
    _illustIndex: 3
    _bgmSwitch: 0
    _backgroundSound: 0
    _seChange: 0
    _effectSound: 0
  - _speakerName: "\uD559\uC608\uBD80\uC7A5"
    _dialogueText: "\uC5EC\uAE30 \uC911\uC559\uC740 \uBA54\uC778 \uD589\uC0AC \uACF5\uAC04\uC73C\uB85C
      \uC4F0\uBA74 \uC88B\uACA0\uC5B4\uC694!"
    _illustHide: 0
    _illustChange: 0
    _illustIndex: 0
    _bgmSwitch: 0
    _backgroundSound: 0
    _seChange: 0
    _effectSound: 0
  - _speakerName: "\uCD1D\uBB34\uBD80\uC7A5"
    _dialogueText: "\u2026\u2026\uADF8\uB7EC\uBA74 \uD544\uC694\uD55C \uC790\uC7AC\uBD80\uD130
      \uACC4\uC0B0\uD574\uBD10\uC57C\uACA0\uB124."
    _illustHide: 0
    _illustChange: 0
    _illustIndex: 0
    _bgmSwitch: 0
    _backgroundSound: 0
    _seChange: 0
    _effectSound: 0
  - _speakerName: "\uD64D\uBCF4\uBD80\uC7A5"
    _dialogueText: "\uC785\uAD6C \uCABD \uB3D9\uC120\uB3C4 \uC2E0\uACBD \uC368\uC57C\uACA0\uACE0."
    _illustHide: 0
    _illustChange: 0
    _illustIndex: 0
    _bgmSwitch: 0
    _backgroundSound: 0
    _seChange: 0
    _effectSound: 0
  - _speakerName: "\uBC14\uB978\uC0DD\uD65C\uBD80\uC7A5"
    _dialogueText: "\uC548\uC804\uD558\uAC8C \uB2E4\uB2D0 \uAE38\uB3C4 \uD655\uBCF4\uD574\uC57C
      \uD574\uC694."
    _illustHide: 0
    _illustChange: 0
    _illustIndex: 0
    _bgmSwitch: 0
    _backgroundSound: 0
    _seChange: 0
    _effectSound: 0
  - _speakerName: 
    _dialogueText: "\uD558\uB098\uC529 \uC774\uC57C\uAE30\uB97C \uAEBC\uB0B4\uB2E4
      \uBCF4\uB2C8,\n\uB9C9\uB9C9\uD558\uAE30\uB9CC \uD588\uB358 \uACF5\uD130\uAC00
      \uC870\uAE08\uC529 \uCD95\uC81C\uC7A5\uCC98\uB7FC \uBCF4\uC774\uAE30 \uC2DC\uC791\uD588\uB2E4."
    _illustHide: 0
    _illustChange: 0
    _illustIndex: 0
    _bgmSwitch: 0
    _backgroundSound: 0
    _seChange: 0
    _effectSound: 0
  - _speakerName: "\uD559\uC0DD\uD68C\uC7A5"
    _dialogueText: "\uC88B\uC544. \uC77C\uB2E8 \uD574\uBCF4\uC790."
    _illustHide: 0
    _illustChange: 0
    _illustIndex: 0
    _bgmSwitch: 0
    _backgroundSound: 0
    _seChange: 0
    _effectSound: 0
  - _speakerName: 
    _dialogueText: "\uD558\uB098\uC529 \uC758\uACAC\uC744 \uBAA8\uC73C\uB2E4 \uBCF4\uB2C8,\n\uC544\uBB34\uAC83\uB3C4
      \uC5C6\uB358 \uACF5\uD130\uC5D0 \uC870\uAE08\uC529\n\uCD95\uC81C\uC758 \uBAA8\uC2B5\uC774
      \uADF8\uB824\uC9C0\uAE30 \uC2DC\uC791\uD588\uB2E4."
    _illustHide: 1
    _illustChange: 0
    _illustIndex: 0
    _bgmSwitch: 0
    _backgroundSound: 0
    _seChange: 0
    _effectSound: 0
