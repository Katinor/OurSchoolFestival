--- !u!114 &639097042
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 639097040}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a2b2a6074ae1165469988c101f29d50f, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  _dialogData:
  - _speakerName: 
    _dialogueText: "\uD68C\uC758\uB97C \uB9C8\uCE58\uACE0 \uD559\uC0DD\uD68C\uC2E4\uB85C
      \uB3CC\uC544\uC654\uC9C0\uB9CC,\n\uB9C9\uC0C1 \uC900\uBE44\uD574\uC57C \uD560
      \uC77C\uC744 \uC815\uB9AC\uD574\uBCF4\uB2C8\n\uB2E4\uC2DC \uBA38\uB9AC\uAC00
      \uC544\uD30C\uC9C0\uAE30 \uC2DC\uC791\uD588\uB2E4."
    _illustHide: 0
    _illustChange: 1
    _illustIndex: 4
    _bgmSwitch: 2
    _backgroundSound: 7
    _seChange: 0
    _effectSound: 0
  - _speakerName: 
    _dialogueText: "\uC608\uC0B0, \uC790\uC7AC, \uC778\uB825, \uC2DC\uC124\u2026\u2026\n\uC544\uBB34\uB9AC
      \uBD10\uB3C4 \uD559\uC0DD\uD68C\uB9CC\uC73C\uB85C \uC804\uBD80 \uD574\uACB0\uD558\uAE30\uB294
      \uC5B4\uB824\uC6CC \uBCF4\uC600\uB2E4."
    _illustHide: 0
    _illustChange: 0
    _illustIndex: 0
    _bgmSwitch: 0
    _backgroundSound: 0
    _seChange: 0
    _effectSound: 0
  - _speakerName: "\uD559\uC0DD\uD68C\uC7A5"
    _dialogueText: "...... \uC5ED\uC2DC \uB2E4\uB978 \uB3D9\uC544\uB9AC\uC758 \uB3C4\uC6C0\uB3C4
      \uBC1B\uC544\uC57C \uD574."
    _illustHide: 0
    _illustChange: 0
    _illustIndex: 0
    _bgmSwitch: 0
    _backgroundSound: 0
    _seChange: 0
    _effectSound: 0
  - _speakerName: 
    _dialogueText: "\uB3C4\uC6C0\uC744 \uBD80\uD0C1\uD560 \uB9CC\uD55C \uC0AC\uB78C\uB4E4\uC744
      \uD558\uB098\uC529 \uB5A0\uC62C\uB824\uBCF4\uB2E4\uAC00...\n\uBB38\uB4DD, \uD55C
      \uC0AC\uB78C\uC774 \uC0DD\uAC01\uB0AC\uB2E4."
    _illustHide: 0
    _illustChange: 0
    _illustIndex: 0
    _bgmSwitch: 0
    _backgroundSound: 0
    _seChange: 0
    _effectSound: 0
  - _speakerName: "\uD559\uC0DD\uD68C\uC7A5"
    _dialogueText: "......\uCE74\uD2F0\uB178\uB974."
    _illustHide: 0
    _illustChange: 0
    _illustIndex: 0
    _bgmSwitch: 0
    _backgroundSound: 0
    _seChange: 0
    _effectSound: 0
  - _speakerName: 
    _dialogueText: "\uBD84\uBA85 \uADC0\uCC2E\uC544\uD560\uD150\uB370."
    _illustHide: 0
    _illustChange: 0
    _illustIndex: 0
    _bgmSwitch: 0
    _backgroundSound: 0
    _seChange: 0
    _effectSound: 0
  - _speakerName: 
    _dialogueText: "\uADF8\uB798\uB3C4 \uC774\uB7F0 \uC77C\uC774\uB77C\uBA74,\n\uAC00\uC7A5
      \uBA3C\uC800 \uB5A0\uC624\uB974\uB294 \uC0AC\uB78C\uB3C4 \uC5ED\uC2DC \uADF8
      \uB140\uC11D\uC774\uC5C8\uB2E4."
    _illustHide: 0
    _illustChange: 0
    _illustIndex: 0
    _bgmSwitch: 0
    _backgroundSound: 0
    _seChange: 0
    _effectSound: 0
  - _speakerName: "\uD559\uC0DD\uD68C\uC7A5"
    _dialogueText: "......\uC77C\uB2E8 \uAC00\uBCFC\uAE4C."
    _illustHide: 1
    _illustChange: 0
    _illustIndex: 0
    _bgmSwitch: 1
    _backgroundSound: 0
    _seChange: 0
    _effectSound: 0
--- !u!1 &648939769
